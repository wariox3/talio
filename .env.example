# Plantilla de variables de entorno de talio.
#
# Copiala a .env y rellena los valores:
#     cp .env.example .env
#
# .env esta en .gitignore, asi que los valores reales NO se versionan.
# Este archivo si se versiona: mantenlo sincronizado cuando agregues o
# quites una variable del codigo.
#
# Orden de carga (gana el ultimo):
#     .env  ->  .env.local  ->  .env.$APP_ENV  ->  .env.$APP_ENV.local
# Las variables reales del sistema ganan sobre cualquier archivo .env.

###> symfony/framework-bundle ###
# dev | prod. APP_DEBUG se deriva de APP_ENV si no se define.
APP_ENV=dev
# Cadena aleatoria. Generar con: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
###< symfony/framework-bundle ###

###> talio/login ###
# Usuario en memoria definido en config/packages/security.yaml.
# Ojo: el password_hasher esta en 'plaintext', la clave se guarda tal cual.
LOGIN_USERNAME=
LOGIN_PASSWORD=
###< talio/login ###

###> talio/servicios ###
# URLs base de los microservicios. DEBEN terminar en "/" porque el codigo
# concatena directo: $_ENV['BASE_X'] . $url  (ver src/Utilidades/).
# Ejemplo: BASE_WOLFRAMIO="http://159.203.18.130/wolframio/public/index.php/"
BASE_ITRIO=
BASE_NIQUEL=
BASE_WOLFRAMIO=
BASE_CARBONO=
BASE_TANTALO=

# Reservada. Todavia ningun codigo de talio la lee: no hay una utilidad
# Nobelio en src/Utilidades/. Queda declarada para el proyecto que la va a
# consumir. Si al final no se usa desde aqui, quitala de este archivo.
BASE_NOBELIO=

# Credenciales del login de Itrio (Itrio::autenticar(), proyecto RUTEOAPP).
ITRIO_USUARIO=
ITRIO_CLAVE=

# API de Kiai/Softgic. Va como CURLOPT_USERPWD, formato "usuario:clave".
KIAI_TOKEN=
###< talio/servicios ###

###> talio/digitalocean-spaces ###
# Credenciales de DigitalOcean Spaces (src/Utilidades/SpaceDO.php).
# DO_REGION arma tambien el endpoint: https://{DO_REGION}.digitaloceanspaces.com
DO_REGION=
DO_CLAVE_ACCESO=
DO_CLAVE_SECRETA=
DO_BUCKET=
###< talio/digitalocean-spaces ###
