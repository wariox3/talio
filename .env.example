# Plantilla de variables de entorno de talio.
#
# Copiala a .env y rellena los valores:
#     cp .env.example .env
#
# .env esta en .gitignore, asi que los valores reales NO se versionan.
# Este archivo si se versiona: mantenlo sincronizado cuando agregues o
# quites una variable del codigo.
#
# Orden de carga (gana el ultimo):
#     .env  ->  .env.local  ->  .env.$APP_ENV  ->  .env.$APP_ENV.local
# Las variables reales del sistema ganan sobre cualquier archivo .env.

###> symfony/framework-bundle ###
# dev | prod. APP_DEBUG se deriva de APP_ENV si no se define.
APP_ENV=dev
# Cadena aleatoria. Generar con: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
###< symfony/framework-bundle ###

###> talio/login ###
# Usuario en memoria definido en config/packages/security.yaml. El login se
# bloquea 15 minutos tras 5 intentos fallidos.
# Ojo: el password_hasher esta en 'plaintext', la clave se guarda tal cual.
LOGIN_USERNAME=
LOGIN_PASSWORD=
###< talio/login ###

###> talio/servicios ###
# URLs base de los microservicios. DEBEN terminar en "/": las rutas del
# codigo van sin "/" inicial y se concatenan a ellas (ver src/Utilidades/).
# Ejemplo: BASE_WOLFRAMIO="http://159.203.18.130/wolframio/public/index.php/"
BASE_ITRIO=
BASE_WOLFRAMIO=
BASE_TANTALO=

# Credenciales del login de Itrio (proyecto RUTEOAPP). El token se guarda en
# la sesion y se renueva solo cuando Itrio lo rechaza.
ITRIO_USUARIO=
ITRIO_CLAVE=

# Nobelio: URL base de la instancia (termina en "/") y su API Key, formato
# "<prefijo>.<secreto>", que viaja como `Authorization: Api-Key ...` y no
# caduca. Para apuntar a otra instancia (produccion, prueba, desarrollo) se
# cambian las dos.
BASE_NOBELIO=
NOBELIO_TOKEN=

# API de Kiai/Softgic. Autenticacion basica, formato "usuario:clave".
KIAI_TOKEN=
###< talio/servicios ###

###> talio/auditoria ###
# PostgreSQL de Lantano, tabla acceso (src/Utilidades/BdWebServer.php).
# Requiere la extension pdo_pgsql (php8.3-pgsql en el servidor).
DATABASE_BDLANTANO_URL="postgresql://usuario:clave@host:5432/base"
###< talio/auditoria ###

###> talio/utilidades ###
# Backblaze B2, bucket de backups (Utilidades > Backblaze > Backups). Basta
# una Application Key de solo lectura (listFiles, readFiles) del bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
###< talio/utilidades ###
