{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Errores · Talio{% endblock %}
{% block ruta %}Níquel <span>/</span> <b>Errores</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ errores|length }} registros</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        <div class="filters">
            {{ ui.campo('Entorno', form.entorno) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {{ form_widget(form.btnEliminar, { 'attr': {'class': 'ghost'} }) }}
                {{ form_widget(form.btnLimpiar, { 'attr': {'class': 'ghost'} }) }}
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th>Fecha</th><th>Archivo</th><th>Mensaje</th>
                    <th>Usuario</th><th>Ruta</th><th>Entorno</th><th>Contenedor</th>
                    <th>Data</th><th></th>
                    <th class="center" title="Seleccionar todos">
                        <input type="checkbox" id="todosInput" aria-label="Seleccionar todos"
                               onclick="ChequearTodosTabla(this, 'ChkSeleccionar[]')">
                    </th>
                </tr>
                </thead>
                <tbody>
                {% for error in errores %}
                    <tr>
                        <td class="id">{{ error.id }}</td>
                        <td class="fecha">{{ error.fecha|date('Y-m-d H:i') }}</td>
                        <td>{{ error.archivo }}</td>
                        <td class="wrap">{{ error.mensaje }}</td>
                        <td>{{ error.usuario }}</td>
                        <td>{{ error.ruta }}</td>
                        <td>
                            {% if error.entorno == 'prod' %}
                                <span class="tag crit"><span class="dot"></span>prod</span>
                            {% else %}
                                <span class="tag idle"><span class="dot"></span>{{ error.entorno }}</span>
                            {% endif %}
                        </td>
                        <td>{{ error.contenedor }}</td>
                        <td>
                            <details>
                                <summary>Ver</summary>
                                <pre>{{ error.data|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                            </details>
                        </td>
                        <td class="nowrap">
                            <a href="javascript:abrirVentana('{{ path('niquel_error_detalle', { 'id': error.id }) }}', 'Error', 500, 1200)">Traza</a>
                        </td>
                        <td class="center">
                            <input type="checkbox" name="ChkSeleccionar[]" value="{{ error.id }}"
                                   id="err{{ error.id }}" aria-label="Seleccionar error {{ error.id }}">
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="11">Sin errores registrados en este entorno.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
