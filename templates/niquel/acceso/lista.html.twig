{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Accesos · Talio{% endblock %}
{% block ruta %}Níquel <span>/</span> <b>Accesos</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ hosts|length }} hosts</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        {{ ui.cabecera('Accesos por host') }}
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr><th>Host</th><th class="num">Accesos</th></tr>
                </thead>
                <tbody>
                {% for host in hosts %}
                    <tr>
                        <td>{{ host.host }}</td>
                        <td class="num">{{ host.total }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2">Sin accesos registrados.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
