<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Talio{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="{{ asset('css/talio.css') }}">
</head>
<body>
<div class="app">
    <nav class="side">
        <div class="brand">
            <b><a href="{{ path('inicio') }}">Talio</a></b>
            <span>1.0</span>
        </div>

        <div class="nav-sec">
            <div class="nav-head">General</div>
            <a class="nav-a {{ app.request.get('_route') == 'inicio' ? 'on' }}" href="{{ path('inicio') }}">Inicio</a>
        </div>

        {% set ruta = app.request.get('_route') %}
        <div class="nav-sec">
            <div class="nav-head">Servicios</div>

            <details class="nav-group" {{ ruta starts with 'wolframio_' ? 'open' }}>
                <summary>Wolframio</summary>
                <div class="nav-sub">
                    <a class="{{ ruta == 'wolframio_monitor' ? 'on' }}" href="{{ path('wolframio_monitor') }}">Monitor</a>
                    <a class="{{ ruta == 'wolframio_cuenta_lista' ? 'on' }}" href="{{ path('wolframio_cuenta_lista') }}">Cuenta</a>
                    <a class="{{ ruta == 'wolframio_documento_enviar' ? 'on' }}" href="{{ path('wolframio_documento_enviar') }}">Documento enviar</a>
                    <a class="{{ ruta == 'wolframio_documento_error' ? 'on' }}" href="{{ path('wolframio_documento_error') }}">Documento error</a>
                    <a class="{{ ruta == 'wolframio_documento_respuesta' ? 'on' }}" href="{{ path('wolframio_documento_respuesta') }}">Documento respuesta</a>
                </div>
            </details>

            <details class="nav-group" {{ ruta starts with 'tantalo_' ? 'open' }}>
                <summary>Tántalo</summary>
                <div class="nav-sub">
                    <a class="{{ ruta == 'tantalo_monitor' ? 'on' }}" href="{{ path('tantalo_monitor') }}">Monitor</a>
                </div>
            </details>

            <details class="nav-group" {{ ruta starts with 'itrio_' ? 'open' }}>
                <summary>Itrio</summary>
                <div class="nav-sub">
                    <a class="{{ ruta == 'itrio_movimiento_lista' ? 'on' }}" href="{{ path('itrio_movimiento_lista') }}">Movimiento</a>
                    <a class="{{ ruta == 'itrio_consumo_lista' ? 'on' }}" href="{{ path('itrio_consumo_lista') }}">Consumo</a>
                    <a class="{{ ruta == 'itrio_contenedor_lista' ? 'on' }}" href="{{ path('itrio_contenedor_lista') }}">Contenedor</a>
                    <a class="{{ ruta == 'itrio_usuario_lista' ? 'on' }}" href="{{ path('itrio_usuario_lista') }}">Usuarios</a>
                </div>
            </details>

            <details class="nav-group" {{ ruta starts with 'nobelio_' ? 'open' }}>
                <summary>Nobelio</summary>
                <div class="nav-sub">
                    {# Ambiente contra el que trabajan todas las pantallas de Nobelio (se guarda en la sesion). #}
                    <form class="nav-ambiente" method="post" action="{{ path('nobelio_ambiente') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('nobelio-ambiente') }}">
                        <input type="hidden" name="ruta" value="{{ ruta }}">
                        <label for="nobelio-ambiente">Ambiente</label>
                        <select id="nobelio-ambiente" name="ambiente" onchange="this.form.submit()">
                            {% set disponibles = nobelio.ambientesDisponibles %}
                            {% for clave, nombre in constant('App\\Utilidades\\Nobelio::AMBIENTES') %}
                                <option value="{{ clave }}" {{ clave == nobelio.ambiente ? 'selected' }} {{ clave not in disponibles ? 'disabled' }}>
                                    {{ nombre }}{{ clave not in disponibles ? ' (sin configurar)' }}
                                </option>
                            {% endfor %}
                        </select>
                        <noscript><button type="submit" class="ghost">Cambiar</button></noscript>
                    </form>
                    <a class="{{ ruta == 'nobelio_emisor_lista' ? 'on' }}" href="{{ path('nobelio_emisor_lista') }}">Emisor</a>
                    <a class="{{ ruta == 'nobelio_documento_lista' ? 'on' }}" href="{{ path('nobelio_documento_lista') }}">Documento</a>
                    <a class="{{ ruta == 'nobelio_nomina_lista' ? 'on' }}" href="{{ path('nobelio_nomina_lista') }}">Nómina</a>
                </div>
            </details>
        </div>

        <div class="nav-sec">
            <div class="nav-head">Servicios externos</div>

            <details class="nav-group" {{ ruta starts with 'kiai_' ? 'open' }}>
                <summary>Kiai</summary>
                <div class="nav-sub">
                    <a class="{{ ruta == 'kiai_consumo_lista' ? 'on' }}" href="{{ path('kiai_consumo_lista') }}">Consumos</a>
                </div>
            </details>
        </div>

        <div class="nav-sec">
            <div class="nav-head">Auditoría</div>

            <details class="nav-group" {{ ruta starts with 'auditoria_webserver_' ? 'open' }}>
                <summary>WebServer</summary>
                <div class="nav-sub">
                    <a class="{{ ruta == 'auditoria_webserver_monitor' ? 'on' }}" href="{{ path('auditoria_webserver_monitor') }}">Monitor</a>
                </div>
            </details>
        </div>

        <div class="side-foot">
            {{ app.user ? app.user.userIdentifier : 'Sin sesión' }}
            <small><a href="{{ path('logout') }}">Salir</a></small>
        </div>
    </nav>

    <div class="main">
        <div class="topbar">
            <div class="path">{% block ruta %}{% endblock %}</div>
            <div class="right">
                {% if ruta starts with 'nobelio_' %}
                    {# Siempre a la vista: produccion en rojo para no confundirla con las de prueba. #}
                    <span class="tag {{ nobelio.ambiente == 'produccion' ? 'crit' : 'warn' }}" title="Ambiente de Nobelio">
                        <span class="dot"></span>Nobelio: {{ nobelio.nombreAmbiente }}
                    </span>
                {% endif %}
                {% block acciones %}{% endblock %}
            </div>
        </div>

        {{ include('_avisos.html.twig') }}

        {% block content %}{% endblock %}
    </div>
</div>

<script src="{{ asset('js/general.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
