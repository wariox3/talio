{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% block title %}Monitor · Talio{% endblock %}
{% block ruta %}<b>Monitor</b>{% endblock %}

{% block acciones %}
    {% set detenidos = (arrServiciosWolframio.colaEmitir ? 0 : 1)
        + (arrServiciosWolframio.colaRespuesta ? 0 : 1)
        + (arrServiciosTantalo.colaDecodificar ? 0 : 1) %}
    {% if detenidos > 0 %}
        <span class="tag crit"><span class="dot"></span>{{ detenidos }} cola{{ detenidos > 1 ? 's' }} detenida{{ detenidos > 1 ? 's' }}</span>
    {% else %}
        <span class="tag ok"><span class="dot"></span>Todas las colas activas</span>
    {% endif %}
    <span class="stamp">{{ "now"|date('H:i:s') }}</span>
{% endblock %}

{% block content %}
    <div class="block">
        {{ ui.cabecera('Servicios') }}
        <div class="states">
            <div class="st">
                <b>Wolframio</b>
                <span class="val">{{ ui.estadoCritico(arrServiciosWolframio.colaEmitir, 'Cola emitir', 'Cola emitir detenida') }}</span>
            </div>
            <div class="st">
                <b>Wolframio</b>
                <span class="val">{{ ui.estadoCritico(arrServiciosWolframio.colaRespuesta, 'Cola respuesta', 'Cola respuesta detenida') }}</span>
            </div>
            <div class="st">
                <b>Tántalo</b>
                <span class="val">{{ ui.estadoCritico(arrServiciosTantalo.colaDecodificar, 'Cola decodificar', 'Cola decodificar detenida') }}</span>
            </div>
            <div class="st">
                <b>Níquel</b>
                <span class="val">
                    {% if arrErrores.prod > 0 %}
                        <span class="tag warn"><span class="dot"></span>{{ arrErrores.prod }} errores en producción</span>
                    {% else %}
                        <span class="tag ok"><span class="dot"></span>Sin errores en producción</span>
                    {% endif %}
                </span>
            </div>
        </div>
    </div>

    <div class="block">
        {{ ui.cabecera('Documentos') }}
        <div class="kpis">
            <a class="kpi {{ arrEstados.enviar > 0 ? 'kpi--accent' : 'kpi--idle' }}" href="{{ path('wolframio_documento_enviar') }}">
                <span class="kpi-head">
                    <span class="kpi-l">Por enviar</span>
                    <svg class="kpi-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l16-8-6 16-2-7-8-1z"/></svg>
                </span>
                <span class="kpi-v">{{ arrEstados.enviar|number_format(0, ',', '.') }}</span>
                <span class="kpi-f">
                    {% if arrEstados.enviar > 0 %}
                        <span class="tag"><span class="dot"></span>En cola de emisión</span>
                    {% else %}
                        <span class="tag idle"><span class="dot"></span>Cola vacía</span>
                    {% endif %}
                    <span class="kpi-ir" aria-hidden="true">→</span>
                </span>
            </a>
            <a class="kpi {{ arrEstados.error > 0 ? 'kpi--crit' : 'kpi--ok' }}" href="{{ path('wolframio_documento_error') }}">
                <span class="kpi-head">
                    <span class="kpi-l">En error</span>
                    <svg class="kpi-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l10 18H2L12 3z"/><path d="M12 10v5M12 18h.01"/></svg>
                </span>
                <span class="kpi-v">{{ arrEstados.error|number_format(0, ',', '.') }}</span>
                <span class="kpi-f">
                    {% if arrEstados.error > 0 %}
                        <span class="tag crit"><span class="dot"></span>Requiere revisión</span>
                    {% else %}
                        <span class="tag ok"><span class="dot"></span>Sin errores</span>
                    {% endif %}
                    <span class="kpi-ir" aria-hidden="true">→</span>
                </span>
            </a>
            <a class="kpi {{ arrEstados.respuesta > 0 ? 'kpi--warn' : 'kpi--idle' }}" href="{{ path('wolframio_documento_respuesta') }}">
                <span class="kpi-head">
                    <span class="kpi-l">Esperando respuesta</span>
                    <svg class="kpi-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                </span>
                <span class="kpi-v">{{ arrEstados.respuesta|number_format(0, ',', '.') }}</span>
                <span class="kpi-f">
                    {% if arrEstados.respuesta > 0 %}
                        <span class="tag warn"><span class="dot"></span>Pendientes de notificar</span>
                    {% else %}
                        <span class="tag idle"><span class="dot"></span>Nada pendiente</span>
                    {% endif %}
                    <span class="kpi-ir" aria-hidden="true">→</span>
                </span>
            </a>
        </div>
    </div>

    <div class="block">
        {{ ui.cabecera('Documentos por hora', 'Últimas 24 h') }}
        <div class="chart-wrap">
            <svg data-grafica
                 data-labels='{{ labels|json_encode|raw }}'
                 data-valores='{{ data|json_encode|raw }}'
                 data-unidad="doc"></svg>
            <div class="chart-tip"></div>
        </div>
        <div class="chart-cap"><i></i>Documentos emitidos</div>
    </div>

    <div class="block">
        {{ ui.cabecera('Últimos documentos') }}
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th>Tipo</th><th>Prefijo</th><th class="num">Número</th>
                    <th>Registro</th><th class="num">Cuenta</th><th>Nombre</th>
                    <th class="num">Total</th><th>Estado</th>
                </tr>
                </thead>
                <tbody>
                {% for documento in ultimosDocumentos %}
                    <tr>
                        <td class="id">
                            <a href="javascript:abrirVentana('{{ path('wolframio_documento_detalle', { 'id': documento.id }) }}', 'Documento', 500, 1200)">{{ documento.id }}</a>
                        </td>
                        <td>{{ documento.documentoClaseAbreviatura }}</td>
                        <td>{{ documento.prefijo }}</td>
                        <td class="num">{{ documento.numero }}</td>
                        <td class="fecha">{{ documento.fechaRegistro|date('Y-m-d H:i') }}</td>
                        <td class="num">{{ documento.cuentaId }}</td>
                        <td>{{ documento.cuentaNombre }}</td>
                        <td class="num">{{ documento.total|number_format(0, ',', '.') }}</td>
                        <td class="nowrap">
                            {% if documento.estadoError %}
                                <span class="tag crit"><span class="dot"></span>Error</span>
                            {% elseif documento.estadoValidado %}
                                <span class="tag ok"><span class="dot"></span>Validado</span>
                            {% elseif documento.estadoEnviado %}
                                <span class="tag warn"><span class="dot"></span>En espera</span>
                            {% else %}
                                <span class="tag idle"><span class="dot"></span>Por enviar</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="9">Sin documentos recientes.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="block">
        {{ ui.cabecera('Documentos por cuenta', "now"|date('Y-m')) }}
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr><th class="num">Cuenta</th><th>Nombre</th><th class="num">Cantidad</th></tr>
                </thead>
                <tbody>
                {% for documento in cuentaPeriodo %}
                    <tr>
                        <td class="num">{{ documento.cuentaId }}</td>
                        <td>{{ documento.cuentaNombre }}</td>
                        <td class="num">{{ documento.cantidad }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3">Sin documentos en el periodo.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="block">
        {{ ui.cabecera('Carbono · pendientes') }}
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr><th>Etapa del negocio</th><th class="num">Cantidad</th></tr>
                </thead>
                <tbody>
                {% for negocio in negocios %}
                    <tr>
                        <td>{{ negocio.negocioEtapa }}</td>
                        <td class="num">{{ negocio.cantidad }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="2">Sin negocios pendientes.</td></tr>
                {% endfor %}
                {% for contacto in contactos %}
                    <tr>
                        <td>Contactos pendientes</td>
                        <td class="num">{{ contacto.cantidad }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/grafica.js') }}"></script>
{% endblock %}
