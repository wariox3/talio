{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Emisores · Talio{% endblock %}
{% block ruta %}Nobelio <span>/</span> <b>Emisores</b>{% endblock %}
{% block acciones %}
    <span class="stamp">{{ total }} emisor{{ total == 1 ? '' : 'es' }}</span>
{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <input type="hidden" name="pagina" value="{{ pagina }}">
    <div class="block">
        <div class="filters">
            {{ ui.campo('Razón social, NIT o nombre comercial', form.search) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {# Siempre renderizados: si se dejan sin renderizar, form_end()
                   llama a form_rest() y los vuelca sueltos al final del form. #}
                {{ form_widget(form.btnAnterior, { 'attr': hayAnterior
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                {{ form_widget(form.btnSiguiente, { 'attr': haySiguiente
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                <span class="f-count">Página {{ pagina }}</span>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Código</th>
                    <th class="num">NIT</th>
                    <th>Razón social</th>
                    <th>Municipio</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th>Facturación</th>
                    <th>Nómina</th>
                    <th>Equivalente</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for emisor in emisores %}
                    <tr>
                        <td class="id">
                            <a href="{{ path('nobelio_emisor_detalle', { 'id': emisor.id }) }}">{{ emisor.id }}</a>
                        </td>
                        <td>{{ emisor.referencia_externa ?? '' }}</td>
                        <td class="num">
                            {{- emisor.numero_identificacion -}}
                        </td>
                        <td>{{ emisor.razon_social }}</td>
                        <td>{{ emisor.municipio_nombre }}</td>
                        <td>{{ emisor.correo }}</td>
                        <td>{{ ui.estado(emisor.activo, 'Activo', 'Inactivo') }}</td>
                        <td>{{ ui.estado(emisor.habilitado_facturacion, 'Habilitado', 'Sin habilitar') }}</td>
                        {# Se habilita aparte de la facturacion: el tramite es en
                           el portal de la DIAN y no hay Set de Pruebas, asi que
                           un emisor puede facturar y no poder emitir nomina. #}
                        <td>{{ ui.estado(emisor.habilitado_nomina, 'Habilitado', 'Sin habilitar') }}</td>
                        {# Igual que la nomina, va por su propio tramite: hay
                           emisores que facturan y no tienen el equivalente. #}
                        <td>{{ ui.estado(emisor.habilitado_documento_equivalente, 'Habilitado', 'Sin habilitar') }}</td>
                        <td class="acciones">
                            <a href="javascript:abrirVentana('{{ path('nobelio_emisor_editar', { 'id': emisor.id }) }}', 'EmisorEditar', 300, 560)">Editar</a>
                            <button type="submit" class="link" form="emisores"
                                    name="emisor" value="{{ emisor.id }}"
                                    onclick="return confirm('¿Eliminar el emisor {{ emisor.razon_social|e('js') }}?')">Eliminar</button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="11">
                            {% if total == 0 %}
                                No hay emisores que mostrar.
                            {% else %}
                                Esta página no tiene resultados.
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
    {# Fuera del form de filtros: los botones de eliminar apuntan aquí con form=. #}
    <form id="emisores" method="post" action="{{ path('nobelio_emisor_eliminar') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('emisores') }}">
    </form>
{% endblock %}
