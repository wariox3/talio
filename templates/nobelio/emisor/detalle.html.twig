{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Emisor {{ emisor.id }} · Talio{% endblock %}
{% block ruta %}
    Nobelio <span>/</span>
    <a href="{{ path('nobelio_emisor_lista') }}">Emisores</a> <span>/</span>
    <b>{{ emisor.razon_social }}</b>
{% endblock %}
{% block content %}
    <div class="block">
        {{ ui.cabecera('Emisor') }}
        <dl class="ficha">
            <dt>Id</dt>
            <dd>{{ emisor.id }}</dd>

            <dt>Razón social</dt>
            <dd>{{ emisor.razon_social }}</dd>

            <dt>Tipo de identificación</dt>
            <dd>{{ emisor.tipo_identificacion }}</dd>
            <dt>Número de identificación</dt>
            <dd>
                {{- emisor.numero_identificacion }}{% if emisor.digito_verificacion %}-{{ emisor.digito_verificacion }}{% endif -%}
            </dd>

            <dt>Tipo de organización</dt>
            <dd>{{ emisor.tipo_organizacion }}</dd>
            <dt>Responsabilidades</dt>
            <dd>
                {% for codigo in emisor.responsabilidades %}
                    {{ codigo }}{% if not loop.last %}, {% endif %}
                {% else %}
                    Sin responsabilidades declaradas.
                {% endfor %}
            </dd>

            <dt>País</dt>
            <dd>{{ emisor.pais }}</dd>
            <dt>Departamento</dt>
            <dd>{{ emisor.departamento }}</dd>

            <dt>Municipio</dt>
            <dd>{{ emisor.municipio }}</dd>
            <dt>Dirección</dt>
            <dd>{{ emisor.direccion }}</dd>

            {# El codigo postal va pegado a la direccion, igual que en la ficha
               del adquiriente: los dos son la misma direccion fiscal. #}
            <dt>Código postal</dt>
            <dd>{{ emisor.codigo_postal }}</dd>
            <dt>Teléfono</dt>
            <dd>{{ emisor.telefono }}</dd>

            {# La ficha son dos parejas por fila (.ficha es una grilla de cuatro
               columnas), asi que los pares van de dos en dos: uno suelto deja la
               fila a medias. El correo de copia entra aqui —hasta ahora no
               salia— y con el vuelven a cuadrar todas las filas. #}
            <dt>Correo</dt>
            <dd>{{ emisor.correo }}</dd>
            <dt>Correo de copia</dt>
            <dd>{{ emisor.correo_copia }}</dd>

            {# La nomina se habilita aparte y sin Set de Pruebas: el tramite es
               en el portal de la DIAN, asi que un emisor que ya factura puede
               seguir sin poder emitirla. Sin la bandera, la DIAN rechaza con la
               regla 92 ("El Emisor del Documento no se encuentra Habilitado"). #}
            <dt>Facturación</dt>
            <dd>{{ ui.estado(emisor.habilitado_facturacion, 'Habilitado', 'Sin habilitar') }}</dd>

            <dt>Nómina</dt>
            <dd>{{ ui.estado(emisor.habilitado_nomina, 'Habilitado', 'Sin habilitar') }}</dd>
            {# El documento equivalente se habilita por su cuenta, igual que la
               nomina. #}
            <dt>Documento equivalente</dt>
            <dd>{{ ui.estado(emisor.habilitado_documento_equivalente, 'Habilitado', 'Sin habilitar') }}</dd>
        </dl>
    </div>
    <div class="block tabs">
        <div class="tabs-head" role="tablist">
            <button type="button" class="tab is-active" role="tab" aria-selected="true" data-panel="certificados">
                Certificado <span class="stamp">{{ certificados|length }}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" data-panel="software">
                Software <span class="stamp">{{ software|length }}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" data-panel="resoluciones">
                Resoluciones <span class="stamp">{{ resoluciones|length }}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" data-panel="webhooks">
                Webhooks <span class="stamp">{{ webhooks|length }}</span>
            </button>
        </div>

        <div class="tab-panel" id="certificados" role="tabpanel">
            <div class="table-scroll">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Archivo</th>
                        <th>Vigente desde</th>
                        <th>Vigente hasta</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for certificado in certificados %}
                        <tr>
                            <td class="id">{{ certificado.id }}</td>
                            <td>{{ certificado.nombre_archivo }}</td>
                            <td class="fecha">{{ certificado.vigente_desde }}</td>
                            <td class="fecha">{{ certificado.vigente_hasta }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Este emisor no tiene certificado cargado.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-panel" id="software" role="tabpanel" hidden>
            {# El tipo llega como codigo ('nomina', 'facturacion'); si Nobelio
               empieza a mandar `tipo_display` se usa esa etiqueta. #}
            {% set tiposSoftware = { 'nomina': 'Nómina', 'facturacion': 'Facturación', 'documento_equivalente': 'Documento equivalente' } %}
            <div class="filters">
                <div class="f-right">
                    <button type="button" class="ghost" onclick="abrirVentana('{{ path('nobelio_emisor_software_nuevo', { 'id': emisor.id }) }}', 'SoftwareNuevo', 430, 640)">Nuevo</button>
                </div>
            </div>
            <div class="table-scroll">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Identificador</th>
                        <th>Tipo</th>
                        <th>Test set id</th>
                        <th>Set de pruebas</th>
                        <th>Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for programa in software %}
                        <tr>
                            <td class="id">{{ programa.id }}</td>
                            <td class="id">{{ programa.identificador }}</td>
                            <td>{{ programa.tipo_display|default(tiposSoftware[programa.tipo]|default(programa.tipo|default(''))) }}</td>
                            <td class="id">{{ programa.test_set_id }}</td>
                            <td>{{ ui.estado(programa.set_pruebas_aceptado, 'Aceptado', 'Sin aceptar') }}</td>
                            {# Solo en el software de nomina: la nomina no se
                               numera con resolucion, asi que es el software
                               quien la siembra. Los documentos de prueba de
                               facturacion se crean desde su resolucion, en la
                               pestaña de al lado. Con el set de pruebas ya
                               aceptado no hay nada que sembrar. #}
                            <td class="acciones">
                                {% if programa.tipo|default('') == 'nomina' and not programa.set_pruebas_aceptado %}
                                    <a href="javascript:abrirVentana('{{ path('nobelio_software_nomina_prueba', { 'id': programa.id }) }}', 'NominaPrueba', 430, 640)">Crear</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">Este emisor no tiene software registrado.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-panel" id="resoluciones" role="tabpanel" hidden>
            <div class="table-scroll">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th class="num">Tipo</th>
                        <th class="num">Número</th>
                        <th>Fecha</th>
                        <th>Prefijo</th>
                        <th class="num">Rango desde</th>
                        <th class="num">Rango hasta</th>
                        <th>Vigente desde</th>
                        <th>Vigente hasta</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for resolucion in resoluciones %}
                        <tr>
                            <td class="id">{{ resolucion.id }}</td>
                            <td class="num">{{ resolucion.tipo_factura }}</td>
                            <td class="num">{{ resolucion.numero_resolucion }}</td>
                            <td class="fecha">{{ resolucion.fecha_resolucion }}</td>
                            <td>{{ resolucion.prefijo }}</td>
                            <td class="num">{{ resolucion.rango_desde }}</td>
                            <td class="num">{{ resolucion.rango_hasta }}</td>
                            <td class="fecha">{{ resolucion.vigente_desde }}</td>
                            <td class="fecha">{{ resolucion.vigente_hasta }}</td>
                            <td>{{ ui.estado(resolucion.activa, 'Activa', 'Inactiva') }}</td>
                            {# Siembra un documento de prueba sobre esta
                               resolucion. Va en ventana y no como boton
                               directo porque el consecutivo se digita: en
                               blanco lo elige Nobelio. #}
                            <td class="acciones">
                                <a href="javascript:abrirVentana('{{ path('nobelio_resolucion_documento_prueba', { 'id': resolucion.id }) }}', 'DocumentoPrueba', 430, 640)">Crear</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="11">Este emisor no tiene resoluciones registradas.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-panel" id="webhooks" role="tabpanel" hidden>
            {# Las URLs a las que Nobelio le avisa al emisor, y de qué. Nobelio
               todavía solo las guarda: el envío de los avisos no está hecho. #}
            <div class="filters">
                <div class="f-right">
                    <button type="button" class="ghost" onclick="abrirVentana('{{ path('nobelio_emisor_webhook_nuevo', { 'id': emisor.id }) }}', 'WebhookNuevo', 430, 640)">Nuevo</button>
                </div>
            </div>
            <div class="table-scroll">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>URL</th>
                        <th>Validación</th>
                        <th>Notificación</th>
                        <th>Creado</th>
                        <th>Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for webhook in webhooks %}
                        <tr>
                            <td class="id">{{ webhook.id }}</td>
                            <td>{{ webhook.nombre }}</td>
                            <td>{{ webhook.url }}</td>
                            <td>{{ ui.estado(webhook.estado_validado, 'Avisa', 'No avisa') }}</td>
                            <td>{{ ui.estado(webhook.estado_notificado, 'Avisa', 'No avisa') }}</td>
                            <td class="fecha">{{ webhook.creado_en ? webhook.creado_en|date('Y-m-d H:i', false) }}</td>
                            <td class="acciones">
                                <a href="javascript:abrirVentana('{{ path('nobelio_emisor_webhook_editar', { 'id': webhook.id }) }}', 'WebhookEditar', 430, 640)">Editar</a>
                                <button type="submit" class="link" form="webhooks-emisor"
                                        name="webhook" value="{{ webhook.id }}"
                                        onclick="return confirm('¿Eliminar el webhook {{ webhook.nombre|e('js') }}?')">Eliminar</button>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7">Este emisor no tiene webhooks registrados.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {# Fuera de las pestañas: los botones de eliminar apuntan aquí con form=. #}
    <form id="webhooks-emisor" method="post" action="{{ path('nobelio_emisor_webhook_eliminar', { 'id': emisor.id }) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('webhooks-emisor') }}">
    </form>
{% endblock %}
