{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% import 'nobelio/_kpis.html.twig' as kpis %}

{% block title %}Monitor Nobelio · Talio{% endblock %}
{% block ruta %}Nobelio <span>/</span> <b>Monitor</b>{% endblock %}

{% block acciones %}
    <span class="stamp">{{ "now"|date('H:i:s', 'America/Bogota') }}</span>
{% endblock %}

{% block content %}
    <div class="block">
        {{ ui.cabecera('Documentos') }}
        <div class="kpis">
            {{ kpis.rechazados('Rechazados por la DIAN', rechazados, 'nobelio_documento_lista') }}
            {{ kpis.pendientes('Pendientes', pendientes, 'nobelio_documento_lista') }}
            {{ kpis.sinRespuestaValidado('Aceptados sin respuesta validado', sinRespuestaValidado, 'nobelio_documento_lista') }}
        </div>
    </div>

    <div class="block">
        {{ ui.cabecera('Nómina') }}
        <div class="kpis">
            {{ kpis.rechazados('Rechazadas por la DIAN', nominasRechazadas, 'nobelio_nomina_lista') }}
            {{ kpis.pendientes('Pendientes', nominasPendientes, 'nobelio_nomina_lista') }}
        </div>
    </div>

    <div class="block">
        {{ ui.cabecera('Software') }}
        <div class="kpis">
            {% if softwareSinSet is null %}
                <div class="kpi kpi--idle">
                    <span class="kpi-head">
                        <span class="kpi-l">Software sin set de pruebas</span>
                        <svg class="kpi-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1"/><path d="M8 20h8M12 16v4"/></svg>
                    </span>
                    <span class="kpi-v">—</span>
                    <span class="kpi-f">
                        <span class="tag idle"><span class="dot"></span>Sin respuesta de Nobelio</span>
                    </span>
                </div>
            {% else %}
                <a class="kpi {{ softwareSinSet > 0 ? 'kpi--warn' : 'kpi--ok' }}" href="{{ path('nobelio_software_lista', { 'set_pruebas_aceptado': 'false' }) }}">
                    <span class="kpi-head">
                        <span class="kpi-l">Software sin set de pruebas</span>
                        <svg class="kpi-ico" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1"/><path d="M8 20h8M12 16v4"/></svg>
                    </span>
                    <span class="kpi-v">{{ softwareSinSet|number_format(0, ',', '.') }}</span>
                    <span class="kpi-f">
                        {% if softwareSinSet > 0 %}
                            <span class="tag warn"><span class="dot"></span>Habilitación pendiente</span>
                        {% else %}
                            <span class="tag ok"><span class="dot"></span>Todos aceptados</span>
                        {% endif %}
                        <span class="kpi-ir" aria-hidden="true">→</span>
                    </span>
                </a>
            {% endif %}
        </div>
    </div>

    <div class="block">
        {{ ui.cabecera('Documentos emitidos por hora', parcial
            ? 'Últimas 24 h · parcial (primeros ' ~ maxDocumentos ~ ')'
            : 'Últimas 24 h · ' ~ totalEmitidos|number_format(0, ',', '.')) }}
        {% if errorGrafica %}
            <p class="hint">No se pudo armar la gráfica: Nobelio no respondió.</p>
        {% else %}
            <div class="chart-wrap">
                <svg data-grafica
                     data-labels="{{ labels|json_encode }}"
                     data-valores="{{ data|json_encode }}"
                     data-unidad="doc"></svg>
                <div class="chart-tip"></div>
            </div>
            <div class="chart-cap"><i></i>Documentos emitidos (sin borradores), por hora de emisión</div>
        {% endif %}
    </div>

    <div class="block">
        {{ ui.cabecera('Últimos documentos', 'Producción · 10 más recientes') }}
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th class="num">Emisor</th>
                    <th>Emisión</th>
                    <th>Adquiriente</th>
                    <th class="num">Total</th>
                    <th>Estado</th>
                </tr>
                </thead>
                <tbody>
                {% set tagPorEstado = { 'aceptado': 'ok', 'rechazado': 'crit', 'enviado': 'warn', 'firmado': 'warn', 'borrador': 'idle' } %}
                {% for documento in ultimosDocumentos %}
                    <tr>
                        <td class="id">
                            <a href="{{ path('nobelio_documento_detalle', { 'id': documento.id }) }}">{{ documento.id }}</a>
                        </td>
                        <td class="id">{{ documento.numero }}</td>
                        <td>{{ documento.documento_tipo_nombre }}</td>
                        <td class="num">
                            <a href="{{ path('nobelio_emisor_detalle', { 'id': documento.emisor }) }}">{{ documento.emisor }}</a>
                        </td>
                        <td class="fecha">{{ documento.fecha_emision }} {{ documento.hora_emision|default('')|slice(0, 5) }}</td>
                        <td>{{ documento.adquiriente.razon_social|default('') }}</td>
                        <td class="num">{{ documento.total_a_pagar|default(0)|number_format(0, ',', '.') }}</td>
                        <td class="nowrap">
                            <span class="tag {{ tagPorEstado[documento.estado_nombre]|default('idle') }}"><span class="dot"></span>{{ documento.estado_nombre|capitalize }}</span>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8">Sin documentos recientes de producción.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/grafica.js') }}"></script>
{% endblock %}
