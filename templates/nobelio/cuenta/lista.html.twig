{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Cuentas · Talio{% endblock %}
{% block ruta %}Nobelio <span>/</span> <b>Cuentas</b>{% endblock %}
{% block acciones %}
    <span class="stamp">{{ total }} cuenta{{ total == 1 ? '' : 's' }}</span>
    <button type="button" class="ghost" onclick="abrirVentana('{{ path('nobelio_cuenta_nuevo') }}', 'CuentaNuevo', 300, 640)">Nuevo</button>
{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <input type="hidden" name="pagina" value="{{ pagina }}">
    <div class="block">
        <div class="filters">
            {{ ui.campo('Nombre', form.search) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {# Siempre renderizados: si se dejan sin renderizar, form_end()
                   llama a form_rest() y los vuelca sueltos al final del form. #}
                {{ form_widget(form.btnAnterior, { 'attr': hayAnterior
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                {{ form_widget(form.btnSiguiente, { 'attr': haySiguiente
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                <span class="f-count">Página {{ pagina }}</span>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for cuenta in cuentas %}
                    <tr>
                        <td class="id">
                            <a href="{{ path('nobelio_cuenta_detalle', { 'id': cuenta.id }) }}">{{ cuenta.id }}</a>
                        </td>
                        <td>{{ cuenta.nombre }}</td>
                        {# Nobelio no borra una cuenta con emisores: responde
                           400 y dice que hay que sacarlos antes. #}
                        <td class="acciones">
                            <button type="submit" class="link" form="cuentas"
                                    name="cuenta" value="{{ cuenta.id }}"
                                    onclick="return confirm('¿Eliminar la cuenta {{ cuenta.nombre|e('js') }}?')">Eliminar</button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">
                            {% if total == 0 %}
                                No hay cuentas que mostrar.
                            {% else %}
                                Esta página no tiene resultados.
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
    {# Fuera del form de filtros: los botones de eliminar apuntan aquí con form=. #}
    <form id="cuentas" method="post" action="{{ path('nobelio_cuenta_eliminar') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('cuentas') }}">
    </form>
{% endblock %}
