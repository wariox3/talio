{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Documentos · Talio{% endblock %}
{% block ruta %}Nobelio <span>/</span> <b>Documentos</b>{% endblock %}
{% block acciones %}
    <span class="stamp">{{ total }} documento{{ total == 1 ? '' : 's' }}</span>
{% endblock %}
{% block content %}
    {# La acción que toca en cada estado. Sale de las guardas de Nobelio: un
       firmado/enviado/aceptado no se puede volver a emitir, solo se envía lo
       firmado, y el estado solo se refresca en enviado y rechazado. Un
       aceptado es terminal y no ofrece ninguna. #}
    {% set accionesPorEstado = {
        'borrador':  [{ 'accion': 'emitir', 'titulo': 'Emitir', 'pregunta': 'Emitir' }],
        'generado':  [{ 'accion': 'emitir', 'titulo': 'Emitir', 'pregunta': 'Emitir' }],
        'firmado':   [{ 'accion': 'enviar', 'titulo': 'Enviar', 'pregunta': 'Enviar a la DIAN' }],
        'enviado':   [{ 'accion': 'actualizar-estado', 'titulo': 'Actualizar estado' }],
        'rechazado': [
            { 'accion': 'emitir', 'titulo': 'Emitir', 'pregunta': 'Volver a emitir' },
            { 'accion': 'actualizar-estado', 'titulo': 'Actualizar estado' }
        ],
    } %}
    {{ form_start(form) }}
    <input type="hidden" name="pagina" value="{{ pagina }}">
    <div class="block">
        <div class="filters">
            {{ ui.campo('Estado', form.estado) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {# Siempre renderizados: si se dejan sin renderizar, form_end()
                   llama a form_rest() y los vuelca sueltos al final del form. #}
                {{ form_widget(form.btnAnterior, { 'attr': hayAnterior
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                {{ form_widget(form.btnSiguiente, { 'attr': haySiguiente
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                <span class="f-count">Página {{ pagina }}</span>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th class="num">Emisor</th>
                    <th>Emisión</th>
                    <th>Adquiriente</th>
                    <th class="num">Total</th>
                    <th>Estado</th>
                    <th>Envío</th>
                    <th class="num">Errores</th>
                    <th>Validación</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for documento in documentos %}
                    <tr>
                        <td class="id">
                            <a href="{{ path('nobelio_documento_detalle', { 'id': documento.id }) }}">{{ documento.id }}</a>
                        </td>
                        <td class="id">{{ documento.numero }}</td>
                        <td>{{ documento.documento_tipo_nombre }}</td>
                        <td class="num">
                            <a href="{{ path('nobelio_emisor_detalle', { 'id': documento.emisor }) }}">{{ documento.emisor }}</a>
                        </td>
                        <td class="fecha">{{ documento.fecha_emision }}</td>
                        <td>{{ documento.adquiriente.razon_social }}</td>
                        <td class="num">{{ documento.total_a_pagar|number_format(0, ',', '.') }}</td>
                        <td>{{ documento.estado_nombre|capitalize }}</td>
                        <td>{{ documento.envio }}</td>
                        <td class="num">
                            {%- set errores = documento.errores|default([]) -%}
                            {% if errores %}
                                <a href="javascript:abrirVentana('{{ path('nobelio_documento_errores', { 'id': documento.id }) }}', 'Errores', 500, 900)">{{ errores|length }}</a>
                            {% else %}
                                0
                            {% endif %}
                        </td>
                        {# El false deja la hora en la zona que trae el API
                           (-05:00); sin el, Twig la pasaria a la zona por
                           defecto de PHP, que aqui es UTC. #}
                        <td class="fecha">
                            {{- documento.fecha_validacion ? documento.fecha_validacion|date('Y-m-d H:i', false) -}}
                        </td>
                        {# Los botones viven dentro del form de filtros, asi que
                           apuntan con form= al de acciones, que va fuera: los
                           formularios no se pueden anidar. Cada uno lleva el id
                           en su value y elige su ruta con formaction. #}
                        <td class="acciones">
                            {% for accion in accionesPorEstado[documento.estado_nombre]|default([]) %}
                                <button type="submit" class="link" form="acciones-documento"
                                        formaction="{{ path('nobelio_documento_accion', { 'accion': accion.accion }) }}"
                                        name="id" value="{{ documento.id }}"
                                        {% if accion.pregunta is defined %}onclick="return confirm('¿{{ accion.pregunta }} el documento {{ documento.numero }}?')"{% endif %}>{{ accion.titulo }}</button>
                            {% endfor %}
                            {# El XML se guarda al firmar y el attached lo
                               envuelve, asi que un borrador o un generado
                               todavia no tienen que descargar. Son descargas,
                               no acciones: van como enlaces GET fuera del form.
                               El attached es lo que se le entrega al
                               adquiriente: el XML firmado y el acuse de la DIAN
                               en un solo documento. Nobelio lo arma aunque la
                               DIAN no haya respondido —sirve para revisarlo—,
                               pero entonces no acredita la validacion. #}
                            {% if documento.estado_nombre not in ['borrador', 'generado'] %}
                                <a href="{{ path('nobelio_documento_descargar', { 'archivo': 'xml', 'id': documento.id }) }}">XML</a>
                                <a href="{{ path('nobelio_documento_descargar', { 'archivo': 'attached', 'id': documento.id }) }}">Attached</a>
                            {% endif %}
                            {# Nobelio no deja borrar lo que la DIAN ya validó,
                               asi que en un aceptado no se ofrece el boton. #}
                            {% if documento.estado_nombre != 'aceptado' %}
                                <button type="submit" class="link" form="acciones-documento"
                                        name="id" value="{{ documento.id }}"
                                        onclick="return confirm('¿Eliminar el documento {{ documento.numero }}?')">Eliminar</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="12">
                            {% if total == 0 %}
                                No hay documentos que mostrar.
                            {% else %}
                                Esta página no tiene resultados.
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
    {# Un solo form para todas las acciones de la tabla: el borrado es su
       action por defecto y las demas lo cambian con formaction. #}
    <form id="acciones-documento" method="post" action="{{ path('nobelio_documento_eliminar') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('acciones-documento') }}">
    </form>
{% endblock %}
