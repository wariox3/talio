{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Documentos · Talio{% endblock %}
{% block ruta %}Nobelio <span>/</span> <b>Documentos</b>{% endblock %}
{% block acciones %}
    <span class="stamp">{{ total }} documento{{ total == 1 ? '' : 's' }}</span>
{% endblock %}
{% block content %}
    {# La acción que toca en cada estado. En Nobelio todo es emitir, que lleva
       el documento a su estado final: un borrador se firma y se envía; un
       firmado —un intento anterior que no llegó a enviar— solo reenvía ese
       mismo CUFE, y un enviado sin veredicto se consulta y se aplica lo que
       diga la DIAN, sin reenviar. Aceptado y rechazado son finales y no
       ofrecen ninguna: el rechazado se borra y se crea de nuevo corregido. #}
    {% set accionesPorEstado = {
        'borrador': [{ 'accion': 'emitir', 'titulo': 'Emitir', 'pregunta': 'Firmar y enviar a la DIAN' }],
        'firmado':  [{ 'accion': 'emitir', 'titulo': 'Reintentar envío', 'pregunta': 'Enviar a la DIAN' }],
        'enviado':  [{ 'accion': 'emitir', 'titulo': 'Actualizar estado' }],
    } %}
    {{ form_start(form) }}
    <input type="hidden" name="pagina" value="{{ pagina }}">
    <div class="block">
        <div class="filters">
            {{ ui.campo('Estado', form.estado) }}
            {# Nobelio no filtra por número exacto: esto va a su SearchFilter,
               que también mira el CUFE y el NIT o nombre del adquiriente. #}
            {{ ui.campo('Número', form.numero) }}
            {{ ui.campo('Id emisor', form.emisor) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {# Siempre renderizados: si se dejan sin renderizar, form_end()
                   llama a form_rest() y los vuelca sueltos al final del form. #}
                {{ form_widget(form.btnAnterior, { 'attr': hayAnterior
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                {{ form_widget(form.btnSiguiente, { 'attr': haySiguiente
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                <span class="f-count">Página {{ pagina }}</span>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Ambiente</th>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th class="num">Emisor</th>
                    <th>Emisión</th>
                    <th>Adquiriente</th>
                    <th class="num">Total</th>
                    <th>Estado</th>
                    <th>Envío</th>
                    <th class="num">Errores</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for documento in documentos %}
                    <tr>
                        <td class="id">
                            <a href="{{ path('nobelio_documento_detalle', { 'id': documento.id }) }}">{{ documento.id }}</a>
                        </td>
                        <td>{{ ui.ambiente(documento.ambiente) }}</td>
                        <td class="id">{{ documento.numero }}</td>
                        <td>{{ documento.documento_tipo_nombre }}</td>
                        <td class="num">
                            <a href="{{ path('nobelio_emisor_detalle', { 'id': documento.emisor }) }}">{{ documento.emisor }}</a>
                        </td>
                        <td class="fecha">{{ documento.fecha_emision }}</td>
                        <td>{{ documento.adquiriente.razon_social }}</td>
                        <td class="num">{{ documento.total_a_pagar|number_format(0, ',', '.') }}</td>
                        <td>{{ documento.estado_nombre|capitalize }}</td>
                        <td>{{ documento.envio }}</td>
                        {# El listado solo trae el conteo —las filas de error las
                           explica el detalle—, asi que el numero es el enlace a
                           la ventana que las va a buscar. #}
                        <td class="num">
                            {%- set totalErrores = documento.total_errores|default(0) -%}
                            {% if totalErrores %}
                                <a href="javascript:abrirVentana('{{ path('nobelio_documento_errores', { 'id': documento.id }) }}', 'Errores', 500, 900)">{{ totalErrores }}</a>
                            {% else %}
                                0
                            {% endif %}
                        </td>
                        {# Los botones viven dentro del form de filtros, asi que
                           apuntan con form= al de acciones, que va fuera: los
                           formularios no se pueden anidar. Cada uno lleva el id
                           en su value y elige su ruta con formaction. #}
                        <td class="acciones">
                            {% for accion in accionesPorEstado[documento.estado_nombre]|default([]) %}
                                <button type="submit" class="link" form="acciones-documento"
                                        formaction="{{ path('nobelio_documento_accion', { 'accion': accion.accion }) }}"
                                        name="id" value="{{ documento.id }}"
                                        {% if accion.pregunta is defined %}onclick="return confirm('¿{{ accion.pregunta }} el documento {{ documento.numero }}?')"{% endif %}>{{ accion.titulo }}</button>
                            {% endfor %}
                            {# Nobelio no deja borrar lo que la DIAN ya validó,
                               asi que en un aceptado no se ofrece el boton. #}
                            {% if documento.estado_nombre != 'aceptado' %}
                                <button type="submit" class="link" form="acciones-documento"
                                        name="id" value="{{ documento.id }}"
                                        onclick="return confirm('¿Eliminar el documento {{ documento.numero }}?')">Eliminar</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="12">
                            {% if total == 0 %}
                                No hay documentos que mostrar.
                            {% else %}
                                Esta página no tiene resultados.
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
    {# Un solo form para todas las acciones de la tabla: el borrado es su
       action por defecto y las demas lo cambian con formaction. El filtro y la
       pagina van repetidos aqui porque este form no es el de los filtros: sin
       ellos, el redirect de la accion devolveria a la primera pagina sin
       filtrar y habria que volver a buscar el documento de al lado. #}
    <form id="acciones-documento" method="post" action="{{ path('nobelio_documento_eliminar') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('acciones-documento') }}">
        <input type="hidden" name="estado" value="{{ estado }}">
        <input type="hidden" name="numero" value="{{ numero }}">
        <input type="hidden" name="emisor" value="{{ emisor }}">
        <input type="hidden" name="pagina" value="{{ pagina }}">
    </form>
{% endblock %}
