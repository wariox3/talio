{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Documento {{ documento.numero }} · Talio{% endblock %}
{% block ruta %}
    Nobelio <span>/</span>
    <a href="{{ path('nobelio_documento_lista') }}">Documentos</a> <span>/</span>
    <b>{{ documento.numero }}</b>
{% endblock %}
{% block acciones %}
    <span class="stamp">{{ documento.estado_nombre|capitalize }}</span>
    {# El XML se guarda al firmar y el attached lo envuelve, asi que un
       borrador todavia no tiene que descargar. Son descargas, no acciones:
       van por GET. El attached es lo que se le entrega al adquiriente: el XML
       firmado y el acuse de la DIAN en un solo documento. Nobelio lo arma
       aunque la DIAN no haya respondido —sirve para revisarlo—, pero entonces
       no acredita la validacion. #}
    {% if documento.estado_nombre|default('') != 'borrador' %}
        <button type="button" class="ghost" onclick="location.href='{{ path('nobelio_documento_descargar', { 'archivo': 'xml', 'id': documento.id }) }}'">XML</button>
        <button type="button" class="ghost" onclick="location.href='{{ path('nobelio_documento_descargar', { 'archivo': 'attached', 'id': documento.id }) }}'">Attached</button>
    {% endif %}
{% endblock %}
{% block content %}
    <div class="block">
        {{ ui.cabecera('Documento') }}
        <dl class="ficha">
            <dt>Id</dt>
            <dd>{{ documento.id }}</dd>
            <dt>Número</dt>
            <dd>{{ documento.numero }}</dd>

            <dt>Prefijo</dt>
            <dd>{{ documento.prefijo }}</dd>
            <dt>Consecutivo</dt>
            <dd>{{ documento.consecutivo }}</dd>

            <dt>Tipo</dt>
            <dd>{{ documento.documento_tipo_nombre }}</dd>
            <dt>Emisor</dt>
            <dd>
                <a href="{{ path('nobelio_emisor_detalle', { 'id': documento.emisor }) }}">{{ documento.emisor }}</a>
            </dd>

            <dt>Estado</dt>
            <dd>{{ documento.estado_nombre|capitalize }}</dd>
            <dt>Descripción del estado</dt>
            <dd>{{ documento.estado_descripcion }}</dd>

            <dt>Emisión</dt>
            <dd>{{ documento.fecha_emision }} {{ documento.hora_emision }}</dd>
            {# El DueDate del XML: la DIAN lo exige cuando la forma de pago es a
               credito, y en contado no viene. #}
            <dt>Vencimiento</dt>
            <dd>{{ documento.fecha_vencimiento }}</dd>

            <dt>Resolución</dt>
            <dd>{{ documento.resolucion_numero }}</dd>
            <dt>Ambiente</dt>
            <dd>{{ ui.ambiente(documento.ambiente) }}</dd>

            <dt>Forma de pago</dt>
            <dd>{{ documento.forma_pago }}</dd>
            <dt>Medio de pago</dt>
            <dd>{{ documento.medio_pago }}</dd>

            <dt>CUFE/CUDE</dt>
            <dd>{{ documento.cufe_cude }}</dd>
            <dt>Track id</dt>
            <dd>{{ documento.track_id }}</dd>

            <dt>Envío</dt>
            <dd>{{ documento.envio }}</dd>
            {# El false deja la hora en la zona que trae el API (-05:00); sin el,
               Twig la pasaria a la zona por defecto de PHP, que aqui es UTC. #}
            <dt>Validación DIAN</dt>
            <dd>{{ documento.fecha_validacion ? documento.fecha_validacion|date('Y-m-d H:i', false) }}</dd>

            {# Nobelio lo marca cuando la pasarela acepta el correo: que se
               envio, no que el adquiriente lo leyera. #}
            <dt>Notificado</dt>
            <dd>{{ ui.estado(documento.notificado, 'Sí', 'No') }}</dd>
            {# Solo lo llevan las notas credito/debito: es el documento que corrigen. #}
            <dt>Documento de referencia</dt>
            <dd>
                {% if documento.documento_referencia %}
                    <a href="{{ path('nobelio_documento_detalle', { 'id': documento.documento_referencia }) }}">{{ documento.documento_referencia }}</a>
                {% endif %}
            </dd>

            {# Va con el de arriba: el ResponseCode que dice por que se corrige
               el documento referenciado. Solo lo llevan las notas, y sus codigos
               validos dependen de si es credito, debito o ajuste. #}
            <dt>Concepto de corrección</dt>
            <dd>{{ documento.concepto_correccion }}</dd>
            <dt>Observaciones</dt>
            <dd>{{ documento.observaciones }}</dd>

            <dt>Creado</dt>
            <dd>{{ documento.creado_en ? documento.creado_en|date('Y-m-d H:i', false) }}</dd>
            <dt>Actualizado</dt>
            <dd>{{ documento.actualizado_en ? documento.actualizado_en|date('Y-m-d H:i', false) }}</dd>
        </dl>

        {{ ui.cabecera('Adquiriente') }}
        {% if adquiriente %}
            <dl class="ficha">
                <dt>Razón social</dt>
                <dd>{{ adquiriente.razon_social }}</dd>
                <dt>Identificación</dt>
                <dd>
                    {{- adquiriente.numero_identificacion }}{% if adquiriente.digito_verificacion %}-{{ adquiriente.digito_verificacion }}{% endif -%}
                </dd>

                <dt>Tipo de identificación</dt>
                <dd>{{ adquiriente.tipo_identificacion }}</dd>
                <dt>Tipo de organización</dt>
                <dd>{{ adquiriente.tipo_organizacion }}</dd>

                <dt>Responsabilidades</dt>
                <dd>
                    {% for codigo in adquiriente.responsabilidades %}
                        {{ codigo }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        Sin responsabilidades declaradas.
                    {% endfor %}
                </dd>
                <dt>País</dt>
                <dd>{{ adquiriente.pais }}</dd>

                <dt>Departamento</dt>
                <dd>{{ adquiriente.departamento }}</dd>
                <dt>Municipio</dt>
                <dd>{{ adquiriente.municipio }}</dd>

                <dt>Dirección</dt>
                <dd>{{ adquiriente.direccion }}</dd>
                <dt>Código postal</dt>
                <dd>{{ adquiriente.codigo_postal }}</dd>

                <dt>Teléfono</dt>
                <dd>{{ adquiriente.telefono }}</dd>
                <dt>Correo</dt>
                <dd>{{ adquiriente.correo }}</dd>
            </dl>
        {% else %}
            <p class="hint">Este documento no tiene adquiriente.</p>
        {% endif %}

        {{ ui.cabecera('Totales') }}
        <dl class="ficha">
            {# La moneda va aqui y no arriba: es la que da sentido a estas
               cifras. #}
            <dt>Moneda</dt>
            <dd>{{ documento.moneda }}</dd>
            <dt>Valor bruto</dt>
            <dd>{{ documento.valor_bruto|number_format(2, ',', '.') }}</dd>

            {# El motivo es el AllowanceChargeReason del descuento o del cargo
               global: va pegado a su cifra, que es lo unico que explica. #}
            <dt>Descuentos</dt>
            <dd>
                {{- documento.total_descuentos|number_format(2, ',', '.') }}
                {%- if documento.descuentos_motivo %} · {{ documento.descuentos_motivo }}{% endif -%}
            </dd>
            <dt>Cargos</dt>
            <dd>
                {{- documento.total_cargos|number_format(2, ',', '.') }}
                {%- if documento.cargos_motivo %} · {{ documento.cargos_motivo }}{% endif -%}
            </dd>

            <dt>Impuestos</dt>
            <dd>{{ documento.total_impuestos|number_format(2, ',', '.') }}</dd>
            <dt>Total a pagar</dt>
            <dd>{{ documento.total_a_pagar|number_format(2, ',', '.') }}</dd>
        </dl>
    </div>

    <div class="block tabs">
        <div class="tabs-head" role="tablist">
            <button type="button" class="tab is-active" role="tab" aria-selected="true" data-panel="detalles">
                Líneas <span class="stamp">{{ detalles|length }}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" data-panel="errores">
                Errores <span class="stamp">{{ errores|length }}</span>
            </button>
            <button type="button" class="tab" role="tab" aria-selected="false" data-panel="eventos">
                Eventos <span class="stamp">{{ eventos|length }}</span>
            </button>
        </div>

        <div class="tab-panel" id="detalles" role="tabpanel">
            <div class="table-scroll">
                <table class="data">
                    <thead>
                    <tr>
                        <th class="num">Línea</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th class="num">Cantidad</th>
                        <th>Unidad</th>
                        <th class="num">Valor unitario</th>
                        <th class="num">Descuento</th>
                        <th class="num">Valor total</th>
                        <th>Impuestos</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for detalle in detalles %}
                        <tr>
                            <td class="num">{{ detalle.numero_linea }}</td>
                            <td class="id">{{ detalle.codigo_producto }}</td>
                            <td class="wrap">{{ detalle.descripcion }}</td>
                            <td class="num">{{ detalle.cantidad|number_format(2, ',', '.') }}</td>
                            <td>{{ detalle.unidad_medida }}</td>
                            <td class="num">{{ detalle.valor_unitario|number_format(2, ',', '.') }}</td>
                            <td class="num">{{ detalle.descuento|number_format(2, ',', '.') }}</td>
                            <td class="num">{{ detalle.valor_total|number_format(2, ',', '.') }}</td>
                            {# Los impuestos de la linea vienen anidados y son
                               pocos (uno o dos): se listan en la celda en vez
                               de abrir una tabla aparte. #}
                            <td class="wrap">
                                {% for impuesto in detalle.impuestos %}
                                    {{ impuesto.tributo_codigo }}
                                    {{ impuesto.tarifa }}%
                                    {{ impuesto.valor|number_format(2, ',', '.') }}
                                    {%- if not loop.last %}<br>{% endif %}
                                {% endfor %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9">Este documento no tiene líneas.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-panel" id="errores" role="tabpanel" hidden>
            <div class="table-scroll">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Regla</th>
                        <th>Tipo</th>
                        <th>Mensaje</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for error in errores %}
                        <tr>
                            <td class="id">{{ error.id }}</td>
                            <td class="id">{{ error.regla }}</td>
                            <td>{{ error.tipo_display|default(error.tipo) }}</td>
                            <td class="wrap">{{ error.mensaje }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Este documento no tiene errores.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-panel" id="eventos" role="tabpanel" hidden>
            {# Nobelio solo registra cambios de estado ante la DIAN —firmado,
               enviado sin veredicto, validado, rechazado—, en orden de fecha.
               Lo que trae `datos` depende del tipo: el CUFE/CUDE al firmar; al
               enviar o validarse, el origen, la operación, el track_id y el
               código de la DIAN; al rechazarse, además los errores. #}
            {% set tiposEvento = {
                'firmado': 'Firmado',
                'enviado': 'Enviado sin veredicto',
                'validado': 'Validado por la DIAN',
                'rechazado': 'Rechazado por la DIAN',
            } %}
            {% set origenes = { 'envio': 'Envío', 'consulta': 'Consulta' } %}
            <div class="table-scroll">
                <table class="data">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Origen</th>
                        <th>Código DIAN</th>
                        <th>Detalle</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for evento in eventos %}
                        {% set datos = evento.datos|default({}) %}
                        <tr>
                            <td class="id">{{ evento.id }}</td>
                            <td class="fecha">{{ evento.fecha ? evento.fecha|date('Y-m-d H:i:s', false) }}</td>
                            <td>{{ tiposEvento[evento.tipo]|default(evento.tipo) }}</td>
                            <td>{{ origenes[datos.origen|default('')]|default(datos.origen|default('')) }}</td>
                            <td class="id">{{ datos.codigo_estado|default('') }}</td>
                            <td class="wrap">
                                {% if datos.cufe_cude|default('') %}<div>CUFE/CUDE: <span class="id">{{ datos.cufe_cude }}</span></div>{% endif %}
                                {% if datos.envio|default('') %}<div>Operación: {{ datos.envio }}</div>{% endif %}
                                {% if datos.track_id|default('') %}<div>Track id: <span class="id">{{ datos.track_id }}</span></div>{% endif %}
                                {% if datos.fecha_validacion|default('') %}<div>Validación: {{ datos.fecha_validacion|date('Y-m-d H:i', false) }}</div>{% endif %}
                                {% for error in datos.errores|default([]) %}<div>{{ error }}</div>{% endfor %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">Este documento no tiene eventos.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
