{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Recepción · Talio{% endblock %}
{% block ruta %}Nobelio <span>/</span> <b>Recepción</b>{% endblock %}
{% block acciones %}
    <span class="stamp">{{ total }} documento{{ total == 1 ? '' : 's' }}</span>
    {# Para el ZIP o XML que llego por otro medio que el buzon. #}
    <button type="button" onclick="abrirVentana('{{ path('nobelio_recepcion_cargar') }}', 'CargarDocumento', 560, 760)">Cargar ZIP</button>
{% endblock %}
{% block content %}
    {% set tipos = constant('App\\Controller\\nobelio\\RecepcionController::TIPOS') %}
    {% set formasPago = constant('App\\Controller\\nobelio\\RecepcionController::FORMAS_PAGO') %}
    {{ form_start(form) }}
    <input type="hidden" name="pagina" value="{{ pagina }}">
    <div class="block">
        <div class="filters">
            {{ ui.campo('Estado recepción', form.estado_recepcion) }}
            {{ ui.campo('Tipo', form.documento_tipo) }}
            {# El ultimo evento que la DIAN registro sobre la factura. #}
            {{ ui.campo('Estado RADIAN', form.radian_estado) }}
            {{ ui.campo('NIT proveedor (sin DV)', form.proveedor) }}
            {{ ui.campo('Emisor (id)', form.emisor) }}
            {{ ui.campo('Correo (id)', form.correo) }}
            {# Sobre la fecha de emision, ambos inclusive. #}
            {{ ui.campo('Emitido desde', form.desde) }}
            {{ ui.campo('Emitido hasta', form.hasta) }}
            {# El SearchFilter de Nobelio mira el numero, el CUFE/CUDE y el NIT
               y la razon social del proveedor. #}
            {{ ui.campo('Número, CUFE o proveedor', form.search) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {# Siempre renderizados: si se dejan sin renderizar, form_end()
                   llama a form_rest() y los vuelca sueltos al final del form. #}
                {{ form_widget(form.btnAnterior, { 'attr': hayAnterior
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                {{ form_widget(form.btnSiguiente, { 'attr': haySiguiente
                    ? {'class': 'ghost'}
                    : {'class': 'ghost', 'disabled': 'disabled'} }) }}
                <span class="f-count">Página {{ pagina }}</span>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Tipo</th>
                    <th>Número</th>
                    <th>Emisión</th>
                    <th class="num">NIT proveedor</th>
                    <th>Proveedor</th>
                    <th class="num">Emisor</th>
                    <th class="num">Correo</th>
                    <th>Moneda</th>
                    <th>Forma de pago</th>
                    <th class="num">Total</th>
                    <th>Validado</th>
                    <th>RADIAN</th>
                    <th>Recepción</th>
                    <th>CUFE/CUDE</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for documento in documentos %}
                    <tr>
                        <td class="id">
                            <a href="{{ path('nobelio_recepcion_detalle', { 'id': documento.id }) }}">{{ documento.id|slice(0, 8) }}…</a>
                        </td>
                        <td>{{ tipos[documento.documento_tipo]|default(documento.documento_tipo) }}</td>
                        <td class="id">{{ documento.numero }}</td>
                        <td class="fecha">{{ documento.fecha_emision }}</td>
                        <td class="num">
                            {{- documento.proveedor_numero_identificacion -}}
                            {%- if documento.proveedor_digito_verificacion %}-{{ documento.proveedor_digito_verificacion }}{% endif -%}
                        </td>
                        <td>{{ documento.proveedor_razon_social }}</td>
                        <td class="num">
                            <a href="{{ path('nobelio_emisor_detalle', { 'id': documento.emisor }) }}">{{ documento.emisor }}</a>
                        </td>
                        <td class="num">
                            <a href="{{ path('nobelio_correo_detalle', { 'id': documento.correo }) }}">{{ documento.correo }}</a>
                        </td>
                        <td>{{ documento.moneda }}</td>
                        <td>{{ documento.forma_pago|default('') ? formasPago[documento.forma_pago]|default(documento.forma_pago) }}</td>
                        <td class="num">{{ documento.total_a_pagar is empty ? '' : documento.total_a_pagar|number_format(2, ',', '.') }}</td>
                        <td>{{ include('nobelio/recepcion/_validacion.html.twig', { codigo: documento.validacion_codigo }) }}</td>
                        <td>{{ include('nobelio/recepcion/_radian.html.twig', { estado: documento.radian_estado|default('') }) }}</td>
                        <td>{{ ui.estado(documento.estado_recepcion|default(false), 'Sí', 'No') }}</td>
                        {# 96 caracteres de SHA-384: el principio y el completo
                           en el title, como el CUNE en la nomina. #}
                        <td class="id" title="{{ documento.cufe_cude }}">
                            {{- documento.cufe_cude ? documento.cufe_cude|slice(0, 12) ~ '…' -}}
                        </td>
                        {# Sin eventos, lo que sigue es el acuse de recibo: abre la
                           ventana del evento con el 030 elegido. Solo en facturas
                           de venta y no de contado: RADIAN no admite eventos sobre
                           ellas (LGC62). #}
                        <td class="acciones">
                            {% if documento.radian_estado|default('') == 'sin_eventos' and documento.documento_tipo == 'factura_venta' and documento.forma_pago|default('') != '1' %}
                                <a href="javascript:abrirVentana('{{ path('nobelio_recepcion_evento_nuevo', { 'id': documento.id, 'codigo': '030' }) }}', 'EventoNuevo', 560, 640)">Acuse 030</a>
                            {% endif %}
                            {# Con el acuse, lo que sigue es el recibo del bien o
                               servicio: abre la ventana con el 032 elegido. Mismas
                               condiciones que el acuse. #}
                            {% if documento.radian_estado|default('') == 'acuse' and documento.documento_tipo == 'factura_venta' and documento.forma_pago|default('') != '1' %}
                                <a href="javascript:abrirVentana('{{ path('nobelio_recepcion_evento_nuevo', { 'id': documento.id, 'codigo': '032' }) }}', 'EventoNuevo', 560, 640)">Recibo 032</a>
                            {% endif %}
                            {# Sin eventos registrados. Un pendiente o rechazado no cambia
                               radian_estado y tambien impide borrar: Nobelio lo
                               comprueba y responde diciendolo. El boton vive dentro
                               del form de filtros, asi que apunta con form= al de
                               eliminar, que va fuera: los formularios no se anidan. #}
                            {% if documento.radian_estado|default('') == 'sin_eventos' %}
                                <button type="submit" class="link" form="eliminar-documento"
                                        formaction="{{ path('nobelio_recepcion_eliminar', { 'id': documento.id }) }}"
                                        onclick="return confirm('¿Eliminar el documento {{ documento.numero }} con sus archivos? No se puede deshacer.')">Eliminar</button>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="16">
                            {% if total == 0 %}
                                No hay documentos recibidos que mostrar.
                            {% else %}
                                Esta página no tiene resultados.
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
    {# Al eliminar desde aqui, un error vuelve a la lista y no a la ficha. #}
    <form id="eliminar-documento" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('eliminar-documento') }}">
        <input type="hidden" name="volver" value="lista">
    </form>
{% endblock %}
