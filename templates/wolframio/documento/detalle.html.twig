{% extends 'base_sin_menu.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block ruta %}Documento <b>{{ documento.id }}</b>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        {{ ui.cabecera('Contenido') }}
        <pre>{{ documento.documento|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    </div>
    <div class="block">
        {{ ui.cabecera('Errores', errores|length ~ ' registros') }}
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr><th>Id</th><th>Fecha</th><th>Mensaje</th></tr>
                </thead>
                <tbody>
                {% for error in errores %}
                    <tr>
                        <td class="id">{{ error.id }}</td>
                        <td class="nowrap">{{ error.fecha|date('Y-m-d H:i') }}</td>
                        <td class="wrap">{{ error.mensaje }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="3">Sin errores registrados.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
