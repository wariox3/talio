{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Documento Respuesta · Talio{% endblock %}
{% block ruta %}Wolframio <span>/</span> Documento <span>/</span> <b>Respuesta</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ documentos|length }} registros</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        <p class="hint" style="margin:0 0 14px;">Estos documentos aún no se han notificado al cliente como enviados.</p>
        <div class="filters">
            <div class="f-right">
                {{ form_widget(form.btnRespuesta) }}
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th class="num">Id cliente</th><th>Prefijo</th><th class="num">Número</th>
                    <th>Fecha</th><th class="num">Cuenta</th><th>Nombre</th>
                    <th class="center">Sel.</th>
                </tr>
                </thead>
                <tbody>
                {% for documento in documentos %}
                    <tr>
                        <td class="id">{{ documento.id }}</td>
                        <td class="num">{{ documento.documentoClienteId }}</td>
                        <td>{{ documento.prefijo }}</td>
                        <td class="num">{{ documento.numero }}</td>
                        <td class="nowrap">{{ documento.fecha|date('Y-m-d') }}</td>
                        <td class="num">{{ documento.cuentaId }}</td>
                        <td>{{ documento.cuentaNombre }}</td>
                        <td class="center">
                            <input type="checkbox" name="ChkSeleccionar[]" value="{{ documento.id }}"
                                   aria-label="Seleccionar documento {{ documento.id }}">
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8">No hay documentos en este estado.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
