{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Cuentas · Talio{% endblock %}
{% block ruta %}Wolframio <span>/</span> <b>Cuentas</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ cuentas|length }} registros</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th class="num">NIT</th><th>Nombre</th>
                    <th>Correo</th><th>Correo facturación</th>
                    <th>Suscriptor</th><th title="Producción facturación">Prod. fac.</th>
                    <th>Empleador</th><th title="Producción nómina">Prod. nóm.</th>
                    <th>Notifica</th><th></th><th class="center">Sel.</th>
                </tr>
                </thead>
                <tbody>
                {% for cuenta in cuentas %}
                    <tr>
                        <td class="id">
                            <a href="javascript:abrirVentana('{{ path('wolframio_cuenta_editar', { 'id': cuenta.id }) }}', 'Cuenta', 500, 1200)">{{ cuenta.id }}</a>
                        </td>
                        <td class="num">{{ cuenta.numeroIdentificacion }}</td>
                        <td>{{ cuenta.nombre }}</td>
                        <td>{{ cuenta.correo }}</td>
                        <td>{{ cuenta.correoFacturacionElectronica }}</td>
                        <td class="nowrap">
                            {% if cuenta.suscriptorSoftgic %}
                                <a href="javascript:abrirVentana('{{ path('wolframio_cuenta_suscriptor', { 'suscriptor': cuenta.suscriptorSoftgic }) }}', 'Suscriptor', 500, 1200)">{{ cuenta.suscriptorSoftgic }}</a>
                            {% else %}
                                <button class="link" name="OpCrear" value="{{ cuenta.id }}">Crear</button>
                            {% endif %}
                        </td>
                        <td class="nowrap">
                            {% if cuenta.suscriptorSoftgic and not cuenta.estadoProduccion %}
                                <button class="link" name="OpHabilitar" value="{{ cuenta.id }}">Set pruebas</button>
                            {% else %}
                                {{ ui.estado(cuenta.estadoProduccion, 'Producción', 'Pruebas') }}
                            {% endif %}
                        </td>
                        <td class="nowrap">
                            {% if cuenta.empleadorSoftgic %}
                                <a href="javascript:abrirVentana('{{ path('wolframio_cuenta_empleador', { 'empleador': cuenta.empleadorSoftgic }) }}', 'Empleador', 500, 1200)">{{ cuenta.empleadorSoftgic }}</a>
                            {% else %}
                                <button class="link" name="OpCrearEmpleador" value="{{ cuenta.id }}">Crear</button>
                            {% endif %}
                        </td>
                        <td class="nowrap">
                            {% if cuenta.empleadorSoftgic and not cuenta.estadoProduccionNomina %}
                                <button class="link" name="OpHabilitarNomina" value="{{ cuenta.id }}">Set pruebas</button>
                            {% else %}
                                {{ ui.estado(cuenta.estadoProduccionNomina, 'Producción', 'Pruebas') }}
                            {% endif %}
                        </td>
                        <td>{{ ui.estado(cuenta.notificar, 'Sí', 'No') }}</td>
                        <td class="nowrap">
                            {% if cuenta.suscriptorSoftgic %}
                                <a href="javascript:abrirVentana('{{ path('wolframio_cuenta_resolucion', { 'suscriptor': cuenta.suscriptorSoftgic }) }}', 'Resoluciones', 500, 1200)">Resoluciones</a>
                            {% endif %}
                        </td>
                        <td class="center">
                            <input type="checkbox" name="ChkSeleccionar[]" value="{{ cuenta.id }}"
                                   aria-label="Seleccionar cuenta {{ cuenta.id }}">
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="12">Sin cuentas.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
