{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Movimientos · Talio{% endblock %}
{% block ruta %}Itrio <span>/</span> <b>Movimientos</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ registros }} registros</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        <div class="filters">
            {{ ui.campo('Factura', form.factura) }}
            {{ ui.campo('Pendiente', form.pendiente) }}
            {{ ui.campo('Id', form.id) }}
            {{ ui.campo('Página', form.pagina) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {{ form_widget(form.btnExcel, { 'attr': {'class': 'ghost'} }) }}
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th>Tipo</th><th>Fecha</th>
                    <th class="num">Total</th><th class="num">Afectado</th><th class="num">Saldo</th>
                    <th class="num">Usuario</th><th>Username</th>
                    <th class="num">Referencia</th><th class="num">Factura</th>
                </tr>
                </thead>
                <tbody>
                {% for movimiento in movimientos %}
                    <tr>
                        <td class="id">
                            <a href="javascript:abrirVentana('{{ path('itrio_movimiento_detalle', { 'id': movimiento.id }) }}', 'Movimiento', 500, 1200)">{{ movimiento.id }}</a>
                        </td>
                        <td>{{ movimiento.tipo }}</td>
                        <td class="nowrap">{{ movimiento.fecha|date('Y-m-d H:i') }}</td>
                        <td class="num">{{ movimiento.vr_total|number_format(0, ',', '.') }}</td>
                        <td class="num">{{ movimiento.vr_afectado|number_format(0, ',', '.') }}</td>
                        <td class="num">{{ movimiento.vr_saldo|number_format(0, ',', '.') }}</td>
                        <td class="num">
                            {% if movimiento.usuario_id %}
                                <a href="javascript:abrirVentana('{{ path('itrio_movimiento_usuario', { 'id': movimiento.usuario_id }) }}', 'Usuario', 500, 1200)">{{ movimiento.usuario_id }}</a>
                            {% endif %}
                        </td>
                        <td>{{ movimiento.usuario__username }}</td>
                        <td class="num">{{ movimiento.movimiento_referencia_id }}</td>
                        <td class="num">{{ movimiento.factura_id }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="10">Sin movimientos para este filtro.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
