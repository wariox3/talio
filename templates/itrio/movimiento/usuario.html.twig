{% extends 'base_sin_menu.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block ruta %}<b>Detalle del usuario</b>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        {{ ui.cabecera('Información de facturación') }}
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>T. Nit</th>
                    <th>Nit</th>
                    <th>DV</th>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Ciudad</th>
                </tr>
                </thead>
                <tbody>
                {% for informacionFacturacion in informacionesFacturacion %}
                    <tr>
                        <td class="id">{{ informacionFacturacion.id }}</td>
                        <td>{{ informacionFacturacion.identificacion_nombre }}</td>
                        <td class="num">{{ informacionFacturacion.numero_identificacion }}</td>
                        <td class="num">{{ informacionFacturacion.digito_verificacion }}</td>
                        <td>{{ informacionFacturacion.nombre_corto }}</td>
                        <td>{{ informacionFacturacion.direccion }}</td>
                        <td>{{ informacionFacturacion.telefono }}</td>
                        <td>{{ informacionFacturacion.correo }}</td>
                        <td>{{ informacionFacturacion.ciudad_nombre }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="9">Sin información de facturación.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
