{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Contenedores · Talio{% endblock %}
{% block ruta %}Itrio <span>/</span> <b>Contenedores</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ contenedores|length }} registros</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        <div class="filters">
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th>Nombre</th><th>Subdominio</th>
                    <th class="num">Plan</th><th>Plan nombre</th><th class="num">Usuario</th>
                </tr>
                </thead>
                <tbody>
                {% for contenedor in contenedores %}
                    <tr>
                        <td class="id">{{ contenedor.id }}</td>
                        <td>{{ contenedor.nombre }}</td>
                        <td>{{ contenedor.subdominio }}</td>
                        <td class="num">{{ contenedor.plan_id }}</td>
                        <td>{{ contenedor.plan_nombre }}</td>
                        <td class="num">{{ contenedor.usuario_id }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">Sin contenedores.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
