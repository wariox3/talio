{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Usuarios · Talio{% endblock %}
{% block ruta %}Itrio <span>/</span> <b>Usuarios</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ usuarios|length }} registros</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        <div class="filters">
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th>Usuario</th><th>Nombre</th><th>Correo</th><th class="num">Saldo</th>
                </tr>
                </thead>
                <tbody>
                {% for usuario in usuarios %}
                    <tr>
                        <td class="id">{{ usuario.id }}</td>
                        <td>{{ usuario.username }}</td>
                        <td>{{ usuario.nombre_corto }}</td>
                        <td>{{ usuario.correo }}</td>
                        <td class="num">{{ usuario.vr_saldo|number_format(0, ',', '.') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Sin usuarios.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
