{% extends 'base.html.twig' %}
{% import '_macros.html.twig' as ui %}
{% block title %}Consumos · Talio{% endblock %}
{% block ruta %}Itrio <span>/</span> <b>Consumos</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ consumos|length }} registros</span>{% endblock %}
{% block content %}
    {{ form_start(form) }}
    <div class="block">
        <div class="filters">
            {{ ui.campo('Fecha desde', form.fechaDesde) }}
            {{ ui.campo('Fecha hasta', form.fechaHasta) }}
            <div class="f-right">
                {{ form_widget(form.btnFiltrar) }}
                {{ form_widget(form.btnExcel, { 'attr': {'class': 'ghost'} }) }}
            </div>
        </div>
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr>
                    <th>Id</th><th>Nombre</th><th class="num">Identificación</th><th>Fecha</th>
                    <th class="num">Usuarios</th><th class="num">Plan</th><th>Plan nombre</th>
                    <th class="num">Precio plan</th><th class="num">RedDoc</th><th class="num">Ruteo</th>
                    <th class="num">Usuario</th><th>Username</th><th>Última conexión</th>
                    <th class="num">Cortesía</th><th class="num">Precio</th><th class="num">Consumo</th>
                </tr>
                </thead>
                <tbody>
                {% for consumo in consumos %}
                    <tr>
                        <td class="id">{{ consumo.id }}</td>
                        <td>{{ consumo.nombre }}</td>
                        <td class="num">{{ consumo.numero_identificacion }}</td>
                        <td class="fecha">{{ consumo.fecha|date('Y-m-d H:i') }}</td>
                        <td class="num">{{ consumo.usuarios }}</td>
                        <td class="num">{{ consumo.plan_id }}</td>
                        <td>{{ consumo.plan_nombre }}</td>
                        <td class="num">{{ consumo.plan_precio|number_format(0, ',', '.') }}</td>
                        <td class="num">{{ consumo.reddoc }}</td>
                        <td class="num">{{ consumo.ruteo }}</td>
                        <td class="num">{{ consumo.usuario_id }}</td>
                        <td>{{ consumo.usuario_username }}</td>
                        <td class="fecha">{{ consumo.fecha_ultima_conexion|date('Y-m-d H:i') }}</td>
                        <td class="num">{{ consumo.cortesia }}</td>
                        <td class="num">{{ consumo.precio|number_format(0, ',', '.') }}</td>
                        <td class="num">{{ consumo.vr_consumo|number_format(0, ',', '.') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="16">Sin consumos en el rango seleccionado.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
