{% extends 'base.html.twig' %}
{% block title %}Backups · Talio{% endblock %}
{% block ruta %}Utilidades <span>/</span> Backblaze <span>/</span> <b>Backups</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ carpetas|length }} carpetas · {{ archivos|length }} archivos</span>{% endblock %}

{% block content %}
    <div class="block block--tight">
        <form class="filters filters--flat" method="get" action="{{ path('utilidades_backblaze_backups') }}">
            <div class="field">
                <label for="servidor">Servidor</label>
                <select id="servidor" name="servidor" onchange="this.form.requestSubmit()">
                    {% for item in servidores %}
                        <option value="{{ item }}" {{ item == servidor ? 'selected' }}>{{ item|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
        </form>
    </div>
    {% include 'utilidades/backblaze/_explorador.html.twig' with {
        ruta_listar: 'utilidades_backblaze_backups',
        ruta_descargar: 'utilidades_backblaze_descargar',
        parametros: { servidor: servidor },
    } %}
{% endblock %}
