{% extends 'base.html.twig' %}
{% block title %}Backups · Talio{% endblock %}
{% block ruta %}Utilidades <span>/</span> Backblaze <span>/</span> <b>Backups</b>{% endblock %}
{% block acciones %}<span class="stamp">{{ carpetas|length }} carpetas · {{ archivos|length }} archivos</span>{% endblock %}

{% macro tamano(bytes) %}
    {%- set unidades = ['B', 'KB', 'MB', 'GB', 'TB'] -%}
    {%- set i = 0 -%}
    {%- for u in unidades|slice(1) -%}
        {%- if bytes >= 1024 -%}{%- set bytes = bytes / 1024 -%}{%- set i = i + 1 -%}{%- endif -%}
    {%- endfor -%}
    {{- i == 0 ? bytes : bytes|number_format(1, ',', '.') }} {{ unidades[i] -}}
{% endmacro %}

{% block content %}
    <div class="block block--tight">
        <form class="filters filters--flat" method="get" action="{{ path('utilidades_backblaze_backups') }}">
            <div class="field">
                <label for="servidor">Servidor</label>
                <select id="servidor" name="servidor" onchange="this.form.requestSubmit()">
                    {% for item in servidores %}
                        <option value="{{ item }}" {{ item == servidor ? 'selected' }}>{{ item|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
        </form>
    </div>
    <div class="block">
        <p class="hint">
            <a href="{{ path('utilidades_backblaze_backups', { servidor: servidor }) }}">raíz</a>
            {% for miga in migas %}
                / {% if loop.last %}<b>{{ miga.nombre }}</b>{% else %}<a href="{{ path('utilidades_backblaze_backups', { servidor: servidor, ruta: miga.ruta }) }}">{{ miga.nombre }}</a>{% endif %}
            {% endfor %}
        </p>
    </div>
    <div class="block">
        <div class="table-scroll">
            <table class="data">
                <thead>
                <tr><th>Nombre</th><th class="num">Tamaño</th><th>Fecha</th><th></th></tr>
                </thead>
                <tbody>
                {% if migas is not empty %}
                    {% set padre = migas|length > 1 ? migas[migas|length - 2].ruta : '' %}
                    <tr><td colspan="4"><a href="{{ path('utilidades_backblaze_backups', { servidor: servidor, ruta: padre }) }}">..</a></td></tr>
                {% endif %}
                {% for carpeta in carpetas %}
                    <tr>
                        <td><a href="{{ path('utilidades_backblaze_backups', { servidor: servidor, ruta: carpeta }) }}">{{ carpeta|slice(directorio|length) }}</a></td>
                        <td class="num"></td><td></td><td></td>
                    </tr>
                {% endfor %}
                {% for archivo in archivos %}
                    <tr>
                        <td>{{ archivo.nombre|slice(directorio|length) }}</td>
                        <td class="num nowrap">{{ _self.tamano(archivo.tamano) }}</td>
                        <td class="fecha">{{ (archivo.fecha // 1000)|date('Y-m-d H:i') }}</td>
                        <td class="acciones"><a href="{{ path('utilidades_backblaze_descargar', { servidor: servidor, archivo: archivo.nombre }) }}">Descargar</a></td>
                    </tr>
                {% endfor %}
                {% if carpetas is empty and archivos is empty %}
                    <tr><td colspan="4">Directorio vacío.</td></tr>
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
